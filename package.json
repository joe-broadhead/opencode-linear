            "title": "My Linear issues",
            "size": "l",
            "template": "list",
            "cadence": 900,
            "mode": "looking",
            "preview": "desktop-only",
            "tools": [
              "linear.issues"
            ],
            "script": "const result = await tools.linear.issues({}); return {items: result.rows.map(row => ({id: row.identifier, text: (row.identifier + ': ' + row.title).slice(0, 200)})), editable: false};"
