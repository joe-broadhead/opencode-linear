{
  "name": "@joe-broadhead/opencode-linear",
  "version": "0.0.0",
  "description": "Unofficial OpenCode plugin for Linear: find, read and cite issues, projects and documents through Linear's official MCP server",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "linear"
  ],
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joe-broadhead/opencode-linear.git"
  },
  "homepage": "https://github.com/joe-broadhead/opencode-linear#readme",
  "bugs": {
    "url": "https://github.com/joe-broadhead/opencode-linear/issues"
  },
  "exports": {
    ".": "./dist/index.js",
    "./tui": "./dist/tui.js"
  },
  "files": [
    "dist",
    "skills",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "opencode": {
    "host": ">=2.2.3 <2.3.0"
  },
  "scripts": {
    "check": "node scripts/check.mjs",
    "typecheck": "node scripts/check.mjs typecheck",
    "build": "node scripts/check.mjs build",
    "test": "node scripts/check.mjs unit",
    "test:host": "node scripts/check.mjs host",
    "test:pack": "node scripts/check.mjs pack",
    "lint": "node scripts/check.mjs forbidden",
    "drift": "node scripts/check-linear-tools.mjs"
  },
  "devDependencies": {
    "@opencode/plugin": "2.2.3",
    "@opencode/sdk": "2.2.3",
    "@opentui/core": "0.8.0",
    "@opentui/solid": "0.8.0",
    "@types/bun": "1.4.4",
    "@types/node": "24.19.2",
    "esbuild": "0.28.2",
    "solid-js": "1.9.17",
    "typescript": "5.9.3"
  }
}
