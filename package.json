    "sources": [
      {
        "id": "linear.activity",
        "kind": "events",
        "reads": "issue",
        "method": "events_list",
        "input": {
          "source": "linear"
        },
        "service": {
          "id": "linear.activity",
          "label": "Activity"
        },
        "operations": [
          "get_workspace",
          "get_user",
          "list_issues",
          "get_notifications"
        ],
        "cadence": {
          "suggestMinutes": 5
        },
        "signals": [
          "bus"
        ],
        "private": true,
        "cost": {
          "class": "free"
        },
        "maxBytes": 900000,
        "urlHosts": [
          "linear.app"
        ]
      },
      {
        "id": "linear.issues",
        "kind": "snapshot",
        "output": "list",
        "method": "issues",
        "input": {
